# AI Control Center — Environment Variables
# Copy this file to .env.local and fill in the values

# Database (MySQL/TiDB)
DATABASE_URL=mysql://user:password@host:3306/database

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SEC-008 FIX: Supabase dashboard URL (no hardcoded project IDs in code)
SUPABASE_DASHBOARD_URL=https://supabase.com/dashboard/project/YOUR_PROJECT_ID

# SEC-009 FIX: Agent API key for authenticating agent heartbeat/task-update requests
# Generate with: openssl rand -hex 32
AGENT_API_KEY=your-secure-random-agent-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain/api/oauth/callback

# Application
NODE_ENV=production
PORT=3000
SESSION_SECRET=your-session-secret-here

# Internal API secret for webhook-style endpoints
INTERNAL_API_SECRET=your-internal-secret-here
